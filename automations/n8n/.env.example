# Copy the relevant values into n8n's private environment file
# (normally /srv/data/state/n8n/.env). Never commit that private file.
ERP_API_URL=https://oliverp.4oli.com
ERP_API_KEY=
ERP_PROJECT_ID=1

# Optional installation-specific Gmail search clause. Keep personal senders
# here, not in the workflow JSON. Use Gmail search syntax.
ERP_MARKETPLACE_EXTRA_GMAIL_QUERY='from:your-email@example.com subject:"Venta confirmada"'
