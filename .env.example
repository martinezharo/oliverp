# Convex application backend
CONVEX_URL=https://your-deployment.convex.cloud
# Optional: prefer this over CONVEX_URL when the local Convex dev URL must stay local.
CONVEX_PRODUCTION_URL=https://your-production-deployment.convex.cloud
# Convex HTTP endpoint used by Better Auth (the matching .convex.site URL).
CONVEX_SITE_URL=https://your-deployment.convex.site
# Public URL of the Astro application, used by Better Auth for trusted origins.
# Also set this value in the Convex deployment with `convex env set SITE_URL`.
SITE_URL=http://localhost:4321
# Server-only. Also set it with `pnpm exec convex env set CONVEX_BRIDGE_SECRET`.
CONVEX_BRIDGE_SECRET=generate-a-long-random-value
