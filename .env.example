# Local development must use a personal Convex dev deployment. Select it with
# `pnpm exec convex deployment select dev`, then verify both values in
# `.env.local`. `pnpm dev` refuses production deployments and mismatched URLs.
CONVEX_DEPLOYMENT=dev:your-dev-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-dev-deployment.convex.cloud
DEV_PUBLIC_URL=https://your-tailnet-host.example.ts.net:8446

# Server-only development bridge secret. Use the same value in `.env.local`
# and the dev Convex environment, and a different secret in production.
# pnpm exec convex env set CONVEX_BRIDGE_SECRET --deployment dev
CONVEX_BRIDGE_SECRET=generate-a-long-random-value

# GitHub App required when private plugin installation is enabled. Keep the
# PKCS#8 private key server-only and configure production through Wrangler.
GITHUB_PLUGINS_APP_ID=
GITHUB_PLUGINS_PRIVATE_KEY=

# Development and production have separate Convex deployments, databases,
# GitHub OAuth Apps, and per-deployment environment variables. GitHub OAuth
# credentials belong in Convex, never in this file. See README.md for the
# development and production callback URLs and setup commands.
