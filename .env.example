# Public Convex URL used by ConvexAuthProvider in the browser.
NEXT_PUBLIC_CONVEX_URL=https://reminiscent-cricket-450.convex.cloud

# Server-only Worker secret. Configure the same value in Convex with:
# pnpm exec convex env set CONVEX_BRIDGE_SECRET
CONVEX_BRIDGE_SECRET=generate-a-long-random-value

# The same Convex deployment is used by local Next development and the Worker.
# Run `pnpm exec auth --prod --web-server-url https://oliverp.4oli.com` once
# to generate Convex Auth's JWT_PRIVATE_KEY and JWKS values in Convex.
# GitHub OAuth credentials belong in Convex, not in this file:
# pnpm exec convex env set AUTH_GITHUB_ID
# pnpm exec convex env set AUTH_GITHUB_SECRET
# Convex Auth's canonical post-login origin (public URL, not a secret):
# pnpm exec convex env set SITE_URL https://oliverp.4oli.com
# Callback: https://reminiscent-cricket-450.convex.site/api/auth/callback/github
