{
    "name": "erp",
    "type": "module",
    "version": "0.0.1",
    "packageManager": "pnpm@11.20.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "convex deploy --cmd 'opennextjs-cloudflare build' && opennextjs-cloudflare deploy",
        "upload": "convex deploy --cmd 'opennextjs-cloudflare build' && opennextjs-cloudflare upload",
        "check": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:convex": "vitest run --config vitest.convex.config.ts",
        "test:watch": "vitest",
        "api:key": "node scripts/create-api-key.mjs",
        "migrate:supabase": "node scripts/migrate-supabase-to-convex.mjs",
        "db:policies:check": "node scripts/check-rls-drift.mjs",
        "test:rls": "vitest run --config vitest.rls.config.ts",
        "test:e2e": "playwright test",
        "prepare": "simple-git-hooks"
    },
    "dependencies": {
        "@auth/core": "0.41.3",
        "@convex-dev/auth": "^0.0.94",
        "@opennextjs/cloudflare": "^1.20.2",
        "@tailwindcss/postcss": "^4.3.3",
        "chart.js": "^4.5.1",
        "convex": "^1.43.0",
        "next": "16.2.11",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@edge-runtime/vm": "^5.0.0",
        "@playwright/test": "^1.61.1",
        "@types/node": "^20.19.0",
        "@types/pg": "^8.20.4",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "convex-test": "^0.0.55",
        "eslint": "^9.0.0",
        "eslint-config-next": "16.2.11",
        "pg": "^8.22.0",
        "simple-git-hooks": "^2.13.1",
        "vite": "^8.2.0",
        "vitest": "^4.1.10",
        "wrangler": "^4.110.0"
    },
    "simple-git-hooks": {
        "pre-push": "pnpm run check && pnpm run test"
    }
}
