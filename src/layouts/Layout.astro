---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import ProjectSelector from "../components/ProjectSelector.astro";
import { ClientRouter } from "astro:transitions";
import { isDemoMode } from "../lib/runtime";
import { ui } from "../i18n/ui";

interface Props {
	title: string;
	description?: string;
	projects?: Array<{ id: number; nombre: string; activo?: boolean }>;
}

const {
	title,
	description = "OlivERP - Management System",
	projects,
} = Astro.props;
const currentPath = Astro.url.pathname;
const { lang, locale, t } = Astro.locals;
const demoMode = isDemoMode(Astro.locals);
const hasWorkspaceSession = demoMode || Boolean(Astro.locals.user);
---

<!DOCTYPE html>
<html lang={lang} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline define:vars={{ lang, locale, dict: ui[lang] }}>
			window.__LANG__ = lang;
			window.__LOCALE__ = locale;
			window.__I18N__ = dict;
		</script>
		<ClientRouter />
		<style>
			body {
				font-family: "Outfit", sans-serif;
			}
			code,
			pre,
			.font-mono {
				font-family: "JetBrains Mono", monospace;
			}
		</style>
	</head>
	<body class="bg-[#0f1016] text-slate-300 min-h-screen overflow-x-hidden">
		<div
			id="navigation-progress"
			data-loading-label={t("common.loadingData")}
			class="fixed inset-x-0 top-0 z-[100] h-1 bg-primary-500/20 opacity-0 transition-opacity duration-200 pointer-events-none"
			role="status"
			aria-live="polite"
			aria-label={t("common.loadingData")}
		>
			<div
				id="navigation-progress-bar"
				class="h-full w-0 bg-primary-400 shadow-[0_0_12px_rgba(var(--primary-400),0.8)] transition-[width] duration-300"
			></div>
			<span class="sr-only">{t("common.loadingData")}</span>
		</div>
		<script is:inline>
			(() => {
				if (window.__navigationFeedbackInitialized) return;
				window.__navigationFeedbackInitialized = true;

				let finishTimer;
				const elements = () => ({
					progress: document.getElementById("navigation-progress"),
					bar: document.getElementById("navigation-progress-bar"),
				});
				const start = () => {
					const { progress, bar } = elements();
					if (!progress || !bar) return;
					window.clearTimeout(finishTimer);
					progress.classList.remove("opacity-0");
					bar.style.width = "20%";
					window.requestAnimationFrame(() => {
						bar.style.width = "65%";
					});
				};
				const ready = () => {
					const { bar } = elements();
					if (!bar) return;
					bar.style.width = "85%";
				};
				const finish = () => {
					const { progress, bar } = elements();
					if (!progress || !bar) return;
					bar.style.width = "100%";
					finishTimer = window.setTimeout(() => {
						progress.classList.add("opacity-0");
						bar.style.width = "0%";
					}, 220);
				};

				document.addEventListener("astro:before-preparation", start);
				document.addEventListener("astro:after-preparation", ready);
				document.addEventListener("astro:after-swap", finish);
			})();
		</script>
		<div class="flex h-screen overflow-hidden">
			<!-- Sidebar -->
			<Sidebar currentPath={currentPath} />

			<!-- Main Content Area -->
			<div
				class="flex-1 flex flex-col min-w-0 transition-all duration-300 ml-0 lg:ml-64 relative"
			>
				<!-- Header -->
				<header
					class="h-16 flex items-center justify-between px-6 border-b border-white/5 bg-[#0f1016]/80 backdrop-blur-md sticky top-0 z-30"
				>
					<div class="flex items-center gap-4">
						<h2
							class="text-xs font-bold text-slate-500 uppercase tracking-widest hidden md:block"
						>
							{title.split("|")[1]?.trim() || t("layout.dashboard")}
						</h2>
					</div>

					<div class="flex items-center gap-6">
						{
							hasWorkspaceSession && (
								<div class="w-40 md:w-64">
									<ProjectSelector projects={projects} />
								</div>
							)
						}

						{
							hasWorkspaceSession && demoMode && (
								<a
									href="/api/demo/exit"
									class="rounded-lg border border-amber-400/20 bg-amber-400/5 px-3 py-2 text-xs font-medium text-amber-200 transition-colors hover:border-amber-300/40 hover:bg-amber-400/10"
								>
									{t("demo.exit")}
								</a>
							)
						}

						{
							hasWorkspaceSession && !demoMode && (
								<form action="/api/auth/signout" method="post">
									<button
										type="submit"
										class="w-10 h-10 rounded-full bg-white/5 hover:bg-red-500/20 flex items-center justify-center transition-colors relative group"
										title={t("layout.signOut")}
									>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											class="w-5 h-5 text-slate-400 group-hover:text-red-400"
											fill="none"
											viewBox="0 0 24 24"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
											/>
										</svg>
									</button>
								</form>
							)
						}
					</div>
				</header>

				<!-- Page Content -->
				<main class="flex-1 overflow-y-auto p-6 scroll-smooth pb-20 lg:pb-6">
					<div class="max-w-7xl mx-auto pb-10">
						<slot />
					</div>
				</main>
			</div>
		</div>
	</body>
</html>
